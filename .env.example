OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGBUDDY_EMBEDDINGS=enabled
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
LANGBUDDY_DB_PATH=state/langbuddy.sqlite3
# legacy (evidence-retained default), bm25, dense, or hybrid (BM25 + RRF)
LANGBUDDY_RETRIEVAL_MODE=legacy
# Only enable with bm25, dense, or hybrid; legacy is the unchanged baseline.
LANGBUDDY_RERANK=disabled
